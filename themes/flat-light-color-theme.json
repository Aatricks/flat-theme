  "tokenColors": [
    {
      "name": "COMMENT",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "comment.line"
      ],
      "settings": {
        "foreground": "#67707f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "VARIABLE",
      "scope": [
        "variable",
        "variable.other",
        "variable.object"
      ],
      "settings": {
        "foreground": "#31424A"
      }
    },
    {
      "name": "VARIABLE BUILTIN",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#116a73"
      }
    },
    {
      "name": "SPECIAL VARIABLE",
      "scope": [
        "variable.other.readwrite.instance",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#7a3fe0"
      }
    },
    {
      "name": "VARIABLE PARAMETER",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#b84c63"
      }
    },
    {
      "name": "VARIABLE MEMBER/PROPERTY",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#4f68c6"
      }
    },
    {
      "name": "CONSTANT",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "name": "STRING",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2f7d32"
      }
    },
    {
      "name": "STRING ESCAPE/REGEXP",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#0077b6"
      }
    },
    {
      "name": "TEMPLATE INTERPOLATION",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "MODULE",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.module"
      ],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "name": "TYPE",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#8c5e10"
      }
    },
    {
      "name": "TYPE BUILTIN",
      "scope": [
        "support.type.builtin",
        "storage.type.builtin",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#8c5e10"
      }
    },
    {
      "name": "MACRO",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#a21caf"
      }
    },
    {
      "name": "FUNCTION",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#245dd8"
      }
    },
    {
      "name": "ATTRIBUTE/DECORATOR",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#b42346"
      }
    },
    {
      "name": "KEYWORD",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.modifier",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "name": "OPERATOR",
      "scope": [
        "keyword.operator",
        "keyword.operator.expression",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#57606a"
      }
    },
    {
      "name": "PUNCTUATION",
      "scope": [
        "punctuation",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6f7686"
      }
    },
    {
      "name": "JSON KEY",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4f68c6"
      }
    },
    {
      "name": "MARKUP HEADING",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#245dd8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKUP BOLD",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#b84c63",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKUP ITALIC",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#b84c63",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MARKUP LINK",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#245dd8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MARKUP CODE",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#2f7d32"
      }
    },
    {
      "name": "DIFF ADDED",
      "scope": [
        "markup.inserted",
        "markup.inserted.diff"
      ],
      "settings": {
        "foreground": "#2f7d32"
      }
    },
    {
      "name": "DIFF DELETED",
      "scope": [
        "markup.deleted",
        "markup.deleted.diff"
      ],
      "settings": {
        "foreground": "#b42346"
      }
    },
    {
      "name": "INVALID",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b42346",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#31424A",
    "parameter": "#b84c63",
    "property": "#4f68c6",
    "enumMember": "#b45309",
    "function": "#245dd8",
    "method": "#245dd8",
    "macro": "#a21caf",
    "type": "#8c5e10",
    "class": "#8c5e10",
    "interface": "#8c5e10",
    "enum": "#8c5e10",
    "typeParameter": "#8c5e10",
    "namespace": "#0369a1",
    "decorator": "#b42346",
    "keyword": "#6f42c1",
    "comment": {
      "foreground": "#67707f",
      "italic": true
    },
    "string": "#2f7d32",
    "number": "#b45309",
    "regexp": "#0077b6",
    "operator": "#57606a",
    "builtinVariable": "#116a73"
  }
}
