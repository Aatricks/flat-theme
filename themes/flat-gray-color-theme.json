  "tokenColors": [
    {
      "name": "COMMENT",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "comment.line"
      ],
      "settings": {
        "foreground": "#9aa0b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "VARIABLE",
      "scope": [
        "variable",
        "variable.other",
        "variable.object"
      ],
      "settings": {
        "foreground": "#CFD8DC"
      }
    },
    {
      "name": "VARIABLE BUILTIN",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "SPECIAL VARIABLE",
      "scope": [
        "variable.other.readwrite.instance",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "VARIABLE PARAMETER",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#f2b5a8"
      }
    },
    {
      "name": "VARIABLE MEMBER/PROPERTY",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#aab8ff"
      }
    },
    {
      "name": "CONSTANT",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "STRING",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "STRING ESCAPE/REGEXP",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "TEMPLATE INTERPOLATION",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "MODULE",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.module"
      ],
      "settings": {
        "foreground": "#74c7ec"
      }
    },
    {
      "name": "TYPE",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "TYPE BUILTIN",
      "scope": [
        "support.type.builtin",
        "storage.type.builtin",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "MACRO",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#f0abfc"
      }
    },
    {
      "name": "FUNCTION",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#82aef7"
      }
    },
    {
      "name": "ATTRIBUTE/DECORATOR",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#f28fad"
      }
    },
    {
      "name": "KEYWORD",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.modifier",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "OPERATOR",
      "scope": [
        "keyword.operator",
        "keyword.operator.expression",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a6adc8"
      }
    },
    {
      "name": "PUNCTUATION",
      "scope": [
        "punctuation",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#969bb2"
      }
    },
    {
      "name": "JSON KEY",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#aab8ff"
      }
    },
    {
      "name": "MARKUP HEADING",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#82aef7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKUP BOLD",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f2b5a8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKUP ITALIC",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f2b5a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MARKUP LINK",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#82aef7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MARKUP CODE",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "DIFF ADDED",
      "scope": [
        "markup.inserted",
        "markup.inserted.diff"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "DIFF DELETED",
      "scope": [
        "markup.deleted",
        "markup.deleted.diff"
      ],
      "settings": {
        "foreground": "#f28fad"
      }
    },
    {
      "name": "INVALID",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f28fad",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#CFD8DC",
    "parameter": "#f2b5a8",
    "property": "#aab8ff",
    "enumMember": "#fab387",
    "function": "#82aef7",
    "method": "#82aef7",
    "macro": "#f0abfc",
    "type": "#f9e2af",
    "class": "#f9e2af",
    "interface": "#f9e2af",
    "enum": "#f9e2af",
    "typeParameter": "#f9e2af",
    "namespace": "#74c7ec",
    "decorator": "#f28fad",
    "keyword": "#cba6f7",
    "comment": {
      "foreground": "#9aa0b8",
      "italic": true
    },
    "string": "#a6e3a1",
    "number": "#fab387",
    "regexp": "#89dceb",
    "operator": "#a6adc8",
    "builtinVariable": "#94e2d5"
  }
}
