  "tokenColors": [
    {
      "name": "COMMENT",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "comment.line"
      ],
      "settings": {
        "foreground": "#9aa0b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "VARIABLE",
      "scope": [
        "variable",
        "variable.other",
        "variable.object"
      ],
      "settings": {
        "foreground": "#c6d0f5"
      }
    },
    {
      "name": "VARIABLE BUILTIN",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#81c8be"
      }
    },
    {
      "name": "SPECIAL VARIABLE",
      "scope": [
        "variable.other.readwrite.instance",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "name": "VARIABLE PARAMETER",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#f2b5a8"
      }
    },
    {
      "name": "VARIABLE MEMBER/PROPERTY",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#aab8ff"
      }
    },
    {
      "name": "CONSTANT",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ef9f76"
      }
    },
    {
      "name": "STRING",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a6d189"
      }
    },
    {
      "name": "STRING ESCAPE/REGEXP",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#99d1db"
      }
    },
    {
      "name": "TEMPLATE INTERPOLATION",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "name": "MODULE",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.module"
      ],
      "settings": {
        "foreground": "#85c1dc"
      }
    },
    {
      "name": "TYPE",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e5c890"
      }
    },
    {
      "name": "TYPE BUILTIN",
      "scope": [
        "support.type.builtin",
        "storage.type.builtin",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#e5c890"
      }
    },
    {
      "name": "MACRO",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#f4b8e4"
      }
    },
    {
      "name": "FUNCTION",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8bb4ff"
      }
    },
    {
      "name": "ATTRIBUTE/DECORATOR",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#f28fad"
      }
    },
    {
      "name": "KEYWORD",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.modifier",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#ca9ee6"
      }
    },
    {
      "name": "OPERATOR",
      "scope": [
        "keyword.operator",
        "keyword.operator.expression",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a5adce"
      }
    },
    {
      "name": "PUNCTUATION",
      "scope": [
        "punctuation",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#969bb2"
      }
    },
    {
      "name": "JSON KEY",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#aab8ff"
      }
    },
    {
      "name": "MARKUP HEADING",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8bb4ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKUP BOLD",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f2b5a8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MARKUP ITALIC",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f2b5a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MARKUP LINK",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8bb4ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MARKUP CODE",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#a6d189"
      }
    },
    {
      "name": "DIFF ADDED",
      "scope": [
        "markup.inserted",
        "markup.inserted.diff"
      ],
      "settings": {
        "foreground": "#a6d189"
      }
    },
    {
      "name": "DIFF DELETED",
      "scope": [
        "markup.deleted",
        "markup.deleted.diff"
      ],
      "settings": {
        "foreground": "#f28fad"
      }
    },
    {
      "name": "INVALID",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f28fad",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#c6d0f5",
    "parameter": "#f2b5a8",
    "property": "#aab8ff",
    "enumMember": "#ef9f76",
    "function": "#8bb4ff",
    "method": "#8bb4ff",
    "macro": "#f4b8e4",
    "type": "#e5c890",
    "class": "#e5c890",
    "interface": "#e5c890",
    "enum": "#e5c890",
    "typeParameter": "#e5c890",
    "namespace": "#85c1dc",
    "decorator": "#f28fad",
    "keyword": "#ca9ee6",
    "comment": {
      "foreground": "#9aa0b8",
      "italic": true
    },
    "string": "#a6d189",
    "number": "#ef9f76",
    "regexp": "#99d1db",
    "operator": "#a5adce",
    "builtinVariable": "#81c8be"
  }
}
